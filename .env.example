# AI runs through the agy CLI (Google Antigravity), using your logged-in subscription. No API key needed.
# Path to the agy binary if it is not on PATH.
# Windows: AGY_BIN=C:/Users/<you>/AppData/Local/agy/bin/agy.exe
# macOS: run `which agy` in Terminal and paste the result, e.g. AGY_BIN=/Users/<you>/.local/bin/agy
# How many agy calls may run at the same time.
# AGY_CONCURRENCY=2

# Optional: draw frame images through Google Flow with gflow-cli (pick a "Google Flow" image model in the app).
# Path to the gflow binary if it is not on PATH, and the login profile to use (default: gflow's default profile).
# GFLOW_BIN=gflow
# GFLOW_PROFILE=storytools

PORT=5174

# Port of the temporary Wi-Fi share page (QR code for the phone). Only open while sharing.
SHARE_PORT=5175
